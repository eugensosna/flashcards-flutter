  "fixed_sql": [
    {
      "name": "decks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"decks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"color\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "flashcards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"flashcards\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"deck_id\" INTEGER NOT NULL REFERENCES decks (id) ON UPDATE CASCADE ON DELETE CASCADE, \"front\" TEXT NOT NULL, \"back\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL DEFAULT 0, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "study_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"study_progress\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"flashcard_id\" INTEGER NOT NULL REFERENCES flashcards (id) ON UPDATE CASCADE ON DELETE CASCADE, \"repetitions\" INTEGER NOT NULL DEFAULT 0, \"interval\" INTEGER NOT NULL DEFAULT 0, \"ease_factor\" REAL NOT NULL DEFAULT 2.5, \"due_date\" INTEGER NOT NULL, \"last_reviewed_at\" INTEGER NULL, \"review_count\" INTEGER NOT NULL DEFAULT 0, UNIQUE (\"flashcard_id\"));"
        }
      ]
    },
    {
      "name": "review_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"flashcard_id\" INTEGER NOT NULL REFERENCES flashcards (id) ON UPDATE CASCADE ON DELETE CASCADE, \"deck_id\" INTEGER NOT NULL REFERENCES decks (id) ON UPDATE CASCADE ON DELETE CASCADE, \"rating\" INTEGER NOT NULL, \"reviewed_at\" INTEGER NOT NULL, \"previous_interval\" INTEGER NOT NULL DEFAULT 0, \"new_interval\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
